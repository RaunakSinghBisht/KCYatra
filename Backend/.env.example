# ─── App ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kcyatra_db

# ─── Security ────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Environment ─────────────────────────────────────────
ENV=development   # development | production
DEBUG=true
